# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Data providers (all optional: missing keys never block replay mode) ---
# Etherscan API V2 (Ethereum, Polygon, Arbitrum on the free tier; BNB Smart Chain is "Paid Tier Only").
# Register at https://etherscan.io/register, then create a key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
# TronGrid (TRON, sent as the TRON-PRO-API-KEY header): sign in at https://www.trongrid.io and create a key in the console
TRONGRID_API_KEY=
# Tronscan (TRON address tags): https://tronscan.org/developer/api (API keys are issued from your Tronscan account)
TRONSCAN_API_KEY=
# Helius (Solana; Solana is disabled in live mode until this is set): sign up at https://www.helius.dev
HELIUS_API_KEY=
# Chainalysis sanctions screening API (optional). Chainalysis announced free sanctions screening tools in 2022;
# request access from Chainalysis (https://www.chainalysis.com) and confirm current terms before use.
CHAINALYSIS_API_KEY=

# --- Security ---
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Shared secret for the simulated SAHYOG inbound webhook (HMAC-SHA256 X-Signature)
SAHYOG_SHARED_SECRET=

# --- Storage and mode ---
# Empty = SQLite at backend/data/ronntech.db. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://ronn:password@localhost:5432/ronntech
DATABASE_URL=
# live (default) | record | replay (offline, fixtures only)
DATA_MODE=live

# --- Seed accounts (scripts/seed_users.py); at least 10 characters each ---
SEED_ADMIN_PASSWORD=
SEED_SUPERVISOR_PASSWORD=
SEED_ANALYST_PASSWORD=

# --- Optional ---
# FRONTEND_ORIGIN=http://localhost:3000
# WATCHLIST_INTERVAL_SECONDS=300
