# Public URLs that browsers use to reach the app and API (set HTTPS URLs in production).
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Optional host ports for Docker Compose.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional SQLAlchemy URL; leave empty to use persistent SQLite storage.
COMPOSE_DATABASE_URL=
